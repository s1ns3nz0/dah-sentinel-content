{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Sentinel is setup"
      }
    }
  },
  "resources": [
    {
      "name": "[concat(parameters('workspaceName'), '/Microsoft.SecurityInsights/Approved_Arm_Operator_List')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/Watchlists",
      "kind": "",
      "properties": {
        "displayName": "Approved_Arm_Operator_List",
        "source": "Approved_Arm_Operator_List.csv",
        "description": "Operators authorized to arm UAV weapons — login privilege != arm privilege (B-10, T0831)",
        "provider": "DAH-BlueTeam",
        "isDeleted": false,
        "labels": [],
        "defaultDuration": "P1000Y",
        "contentType": "Text/Csv",
        "numberOfLinesToSkip": 0,
        "itemsSearchKey": "OperatorId",
        "rawContent": "OperatorId,ArmAuthority,AssignedUAVId,ValidUntil\r\nop-001,true,MPD-001,2026-12-31\r\nop-001,true,MPD-002,2026-12-31"
      },
      "apiVersion": "2022-08-01"
    }
  ]
}