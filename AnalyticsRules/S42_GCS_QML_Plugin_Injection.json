{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/eb373655-6491-4d0e-827b-a2b499be7cb1')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/eb373655-6491-4d0e-827b-a2b499be7cb1')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S42 - GCS QML/Plugin Injection",
        "description": "GCS(QGroundControl류) 앱의 QML 컴포넌트/플러그인 인젝션 탐지. qml_load 이벤트가 공식 경로(qrc:/qml/, /opt/qgc/plugins/official/)가 아닌 곳에서 로드되거나, plugin_exec 이벤트의 바이너리가 미서명(BinarySigned=false)인 경우 탐지 — GCS 프로세스 내 임의 코드 실행 시도. MITRE: T1059",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet knownComponentPaths = dynamic([\"qrc:/qml/\", \"/opt/qgc/plugins/official/\"]);\nUAVGcsApp_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType in (\"qml_load\", \"plugin_exec\")\n| where not(SourceHost has_any (knownComponentPaths)) or BinarySigned == false\n| extend TriggerReason = case(\n    EventType == \"plugin_exec\" and BinarySigned == false, \"GCS_미서명_플러그인_실행\",\n    EventType == \"qml_load\" and not(SourceHost has_any (knownComponentPaths)), \"GCS_비정상_QML컴포넌트_로드\",\n    \"GCS_플러그인_비정상_경로_실행\")\n| extend Severity = \"High\"\n| project TimeGenerated, GcsHost, Operator, ComponentName, EventType, SourceHost, BinarySigned, PayloadDetail, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Execution"
        ],
        "techniques": [
          "T1059"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S42 - GCS QML/Plugin Injection - {{GcsHost}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | ComponentName={{ComponentName}} | SourceHost={{SourceHost}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "ComponentName": "ComponentName",
          "Operator": "Operator"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "GcsHost"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
