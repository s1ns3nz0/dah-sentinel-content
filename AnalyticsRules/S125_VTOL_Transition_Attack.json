{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/78447081-7d4e-4713-9cdc-cfa0507572be')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/78447081-7d4e-4713-9cdc-cfa0507572be')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S125 - VTOL Transition Window Attack",
        "description": "UAVOpmode_CL에서 OpmodeField='vtol_transition_window'인 레코드 중 ExpectedValue(승인된 천이 조건: 고도/속도 창)와 ObservedValue(실제 천이 시점 조건)가 불일치하고 Authorized=0(SByte)인 비인가 강제 천이 탐지. 실제 컬럼: OpmodeField/ExpectedValue/ObservedValue/ChangedBy/Authorized(SByte). MITRE: T0827 Loss of Control (안전 천이 창을 벗어난 시점에 VTOL 천이를 강제해 통제권을 상실시킴)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nUAVOpmode_CL\n| where TimeGenerated > ago(alertWindow)\n| where OpmodeField == 'vtol_transition_window'\n| where ExpectedValue != ObservedValue and Authorized == 0\n| extend TriggerReason = strcat(\"VTOL천이_비인가강제_\", UAVId, \"_\", ExpectedValue, \"->\", ObservedValue)\n| project TimeGenerated, UAVId, OpmodeField, ExpectedValue, ObservedValue, ChangedBy, Authorized, Seq, TriggerReason\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1489"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S125 - VTOL Transition Window Attack - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | ChangedBy={{ChangedBy}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Authorized": "Authorized"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          },
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "ChangedBy"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
