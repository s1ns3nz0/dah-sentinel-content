{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/1c4cc846-343a-4978-96fb-58d11c6726ad')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/1c4cc846-343a-4978-96fb-58d11c6726ad')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S37 - Cyber Posture (CT) Level Unauthorized Change",
        "description": "사이버태세(CT) 레벨 비인가 변경 탐지. Approved_CT_Transition_List에 없는 변경자(ChangedBy)의 CT 레벨 변경을 탐지. 실제 컬럼: PreviousLevel, Level(LevelBefore/LevelAfter 없음), ChangedBy. MITRE: T1601",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet ApprovedChangers = _GetWatchlist('Approved_CT_Transition_List') | project OperatorId;\nUAVCyberPosture_CL\n| where TimeGenerated > ago(alertWindow)\n| where ChangedBy !in (ApprovedChangers)\n| extend TriggerReason = strcat(\"CT레벨_비인가_변경자:\", ChangedBy, \"_\", PreviousLevel, \"→\", Level)\n| extend Severity = \"High\"\n| project TimeGenerated, ChangedBy, PreviousLevel, Level, Reason, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "DefenseEvasion",
          "Impact"
        ],
        "techniques": [
          "T1601"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S37 - Cyber Posture (CT) Level Unauthorized Change - {{ChangedBy}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "PreviousLevel": "PreviousLevel",
          "Level": "Level"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "ChangedBy"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
