{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/b18741ee-c170-479a-817e-41def575eafb')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/b18741ee-c170-479a-817e-41def575eafb')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S126 - Takeoff/Landing Phase Attack",
        "description": "UAVTelemetry_CL에서 저고도(AltRel_m < 임계값) 구간 중 ClimbRate_ms 이상 거동 또는 ARM/DISARM(Command=400) 명령이 함께 관측되는 이착륙 위상 이상 징후를 탐지. UAVOpmode_CL은 존재하지 않아 실제 텔레메트리 상대고도/승강률/명령 컬럼 기반으로 재구성. MITRE: T0880 Loss of Safety (이착륙과 같은 저고도·저속 취약 위상에서 안전장치를 우회해 사고를 유발)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nlet LowAltThreshold_m = 20.0;\nlet ClimbRateAnomalyThreshold = 8.0; // m/s\nlet ArmDisarmCommand = 400; // MAV_CMD_COMPONENT_ARM_DISARM\nUAVTelemetry_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotnull(AltRel_m) and AltRel_m >= 0 and AltRel_m < LowAltThreshold_m\n| where isnotnull(ClimbRate_ms)\n| where abs(ClimbRate_ms) > ClimbRateAnomalyThreshold or Command == ArmDisarmCommand\n| extend TriggerReason = strcat(\"이착륙위상_이상거동_\", UAVId, \"_고도:\", tostring(AltRel_m), \"m_ClimbRate:\", tostring(ClimbRate_ms))\n| project TimeGenerated, UAVId, AltRel_m, ClimbRate_ms, Command, TriggerReason\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "DefenseEvasion"
        ],
        "techniques": [
          "T1562"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S126 - Takeoff/Landing Phase Attack - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "AltRel_m": "AltRel_m"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}