{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/4d29149f-2145-4bfd-9e10-77690eb10d95')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/4d29149f-2145-4bfd-9e10-77690eb10d95')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S23 - GNSS Jamming (Loss of Control/Availability)",
        "description": "UAVDatalinkConn_CL의 JamIndicator가 UAV_Threshold_List의 MaxJamIndicator를 초과하고 동시에 LinkState가 Degraded/Lost인 경우 GNSS 재밍으로 인한 통제·가용성 상실로 탐지. 임계값은 Watchlist로 동적 산출. MITRE ICS ATT&CK: T0814(Denial of Service), T0813(Denial of Control), T0827(Loss of Control) / MITRE: T1498(근접기법)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet jsRatioGate = 6.0;\nUAVCounterUas_CL\n| where TimeGenerated > ago(alertWindow)\n| where Band has 'gnss' or JamMode has 'gnss'\n| where JsRatio_dB > jsRatioGate\n| extend TriggerReason = strcat('GNSS_재밍_통제가용성상실_JsRatio:', tostring(JsRatio_dB), 'dB_Band:', Band, '_Effect:', Effect)\n| extend Severity = iff(Effect has 'loss' or Effect has 'control', 'High', 'Medium')\n| project TimeGenerated, UAVId, Band, JamMode, JamFreqMHz, JamEirp_dBm, JsRatio_dB, Effect, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1498",
          "T1499",
          "T1489"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S23 - GNSS Jamming (Loss of Control/Availability) - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | JsRatio_dB={{JsRatio_dB}} | Band={{Band}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "JsRatio_dB": "JsRatio_dB",
          "Band": "Band",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
