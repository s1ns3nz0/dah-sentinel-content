{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/8e976de1-a141-41be-ac9e-bedbef009c57')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/8e976de1-a141-41be-ac9e-bedbef009c57')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S108 - Swarm Mesh Partition (Isolation/Split)",
        "description": "UAVSwarmComms_CL의 link_status 메시지에서 PartitionDetected=true 또는 LinkSeveredCount>=2인 메시 파티션(군집 고립·분단) 탐지. MITRE: T0814 Denial of Service (ICS — description 참조)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet severedThreshold = 2;\nUAVFleetInfra_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(LinkA) and isnotempty(LinkB)\n| where LinkStatus in (\"down\", \"severed\")\n| summarize SeveredLinkCount = dcount(strcat(LinkA, \"-\", LinkB)), MaxTime = max(TimeGenerated)\n    by FleetId, bin(TimeGenerated, 5m)\n| where SeveredLinkCount >= severedThreshold\n| extend TriggerReason = strcat(\"메시파티션_군집고립의심_단절링크수_\", tostring(SeveredLinkCount), \"_FleetId_\", FleetId)\n| extend Severity = \"High\"\n| project TimeGenerated = MaxTime, FleetId, SeveredLinkCount, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S108 - Swarm Mesh Partition (Isolation/Split) - {{FleetId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "SeveredLinkCount": "SeveredLinkCount",
          "FleetId": "FleetId"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "FleetId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
