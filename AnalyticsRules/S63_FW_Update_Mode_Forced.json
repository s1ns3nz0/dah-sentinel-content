{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/1382e620-6efc-418c-9464-14c8cdb9d87e')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/1382e620-6efc-418c-9464-14c8cdb9d87e')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S63 - Firmware Update Mode Forced Entry",
        "description": "UAVTelemetry_CL에서 COMMAND_LONG(Command=246 MAV_CMD_PREFLIGHT_REBOOT_SHUTDOWN, Param1=3 FW업데이트모드진입)이 야간 비정비시간대(OffHours)에 발생하는 비인가 FW 업데이트모드 강제진입 탐지. MITRE: T0800",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet offHoursStart = 22;\nlet offHoursEnd = 6;\nUAVTelemetry_CL\n| where TimeGenerated > ago(alertWindow)\n| where Command == 246\n| where Param1 == 3\n| extend HourOfDay = hourofday(TimeGenerated)\n| extend isOffHours = HourOfDay >= offHoursStart or HourOfDay < offHoursEnd\n| where isOffHours\n| extend TriggerReason = strcat(\"FW업데이트모드_강제진입_PREFLIGHT_REBOOT_SHUTDOWN_\", UAVId, \"_야간시간대\")\n| extend Severity = \"High\"\n| project TimeGenerated, UAVId, SystemId, ComponentId, TargetSystem, TargetComponent, Command, Param1, isOffHours, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S63 - Firmware Update Mode Forced Entry - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Command={{Command}} | isOffHours={{isOffHours}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Command": "Command",
          "Param1": "Param1",
          "isOffHours": "isOffHours"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
