{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/d840068b-1652-4c1b-a050-8a3c4810ba1e')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/d840068b-1652-4c1b-a050-8a3c4810ba1e')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S28 - WiFi Default Credentials / SSID Tampering",
        "description": "UAVWifi_CL에서 AuthResult == 'default_cred'(공장초기 자격증명으로 인증 성공)이거나 SSID가 알려진 승인 목록(knownSSIDs)에 없는 경우 기본 자격증명 악용 또는 SSID 변조로 탐지. MITRE: T1078, T1552",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 15m;\nlet knownSSIDs = dynamic(['UAV-C2-SECURE', 'GCS-MESH-01']);\nUAVWifi_CL\n| where TimeGenerated > ago(alertWindow)\n| where FrameType == 'auth'\n| where AuthResult == 'default_cred' or SSID !in (knownSSIDs)\n| extend TriggerReason = case(\n    AuthResult == 'default_cred', strcat('WiFi_기본자격증명_사용_', ClientMAC),\n    strcat('WiFi_SSID_변조의심_', SSID))\n| extend Severity = 'Medium'\n| project TimeGenerated, UAVId, SSID, BSSID, ClientMAC, AuthResult, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "InitialAccess",
          "CredentialAccess"
        ],
        "techniques": [
          "T1078",
          "T1552"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S28 - WiFi Default Credentials / SSID Tampering - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | SSID={{SSID}} | AuthResult={{AuthResult}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "SSID": "SSID",
          "AuthResult": "AuthResult",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
