{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/c9210c73-1840-4583-9dbd-e4b18420881d')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/c9210c73-1840-4583-9dbd-e4b18420881d')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S82 - Telemetry Ingest Poisoning (Forged Payload)",
        "description": "텔레메트리 수집(ingest) 경로에서 페이로드 체크섬 검증 실패(PayloadChecksumValid=false)를 탐지. 수집 소스(IngestSource)의 위조/오염된 텔레메트리 주입 시도. MITRE: T1565.001",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet pctThreshold = 0.5;\nUAVFleetInfra_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(Rule)\n| extend PctChange = iif(ValueBefore != 0, abs(ValueAfter - ValueBefore) / abs(ValueBefore), real(null))\n| where isnotnull(PctChange) and PctChange > pctThreshold\n| extend TriggerReason = strcat(\"텔레메트리_ingest_이상값변경_\", Rule, \"_before:\", ValueBefore, \"_after:\", ValueAfter)\n| extend Severity = \"High\"\n| project TimeGenerated, FleetId, TargetId, Rule, ValueBefore, ValueAfter, ChangedBy, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1565"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S82 - Telemetry Ingest Poisoning - {{Rule}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | ValueBefore={{ValueBefore}} | ValueAfter={{ValueAfter}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Rule": "Rule",
          "ChangedBy": "ChangedBy"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "FleetId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}