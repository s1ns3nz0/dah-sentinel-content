{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/cfbf0b54-8edb-4ae8-aa65-cff73faf7154')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/cfbf0b54-8edb-4ae8-aa65-cff73faf7154')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S84 - C4I Message Injection (Forged Order)",
        "description": "C4I 메시지 발신 출처(MessageOrigin)가 존재하나 서명 검증이 실패(SignatureValid=false)한 주문 유형(OrderType)의 위조 명령 주입을 탐지. MITRE: T1565",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet ApprovedOps = _GetWatchlist('Approved_Operators_List') | project OperatorId;\nlet responseBytesGate = 100000;\nUAVC4I_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(IssuedBy)\n| extend isUnapprovedIssuer = IssuedBy !in (ApprovedOps)\n| extend isAnomalousResponse = ResponseBytes > responseBytesGate\n| where isUnapprovedIssuer or isAnomalousResponse\n| extend TriggerReason = case(\n    isUnapprovedIssuer and isAnomalousResponse, strcat(\"C4I_메시지주입_비인가발신자_이상응답_\", IssuedBy),\n    isUnapprovedIssuer, strcat(\"C4I_메시지주입_비인가발신자_\", IssuedBy),\n    strcat(\"C4I_메시지주입_이상응답크기_\", ClientIp, \"_bytes:\", ResponseBytes))\n| extend Severity = \"High\"\n| project TimeGenerated, OrderId, IssuedBy, ClientIp, ResponseBytes, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1565"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S84 - C4I Message Injection - {{OrderId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | IssuedBy={{IssuedBy}} | ResponseBytes={{ResponseBytes}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "OrderId": "OrderId",
          "IssuedBy": "IssuedBy"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "IssuedBy"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}