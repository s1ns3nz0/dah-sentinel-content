{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/a4536b12-8dd8-4046-8a5b-570370833fd8')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/a4536b12-8dd8-4046-8a5b-570370833fd8')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S61 - Data Destruction (Logs / Mission / SAR Frames)",
        "description": "UAVFileAudit_CL에서 짧은 시간창 내 동일 컨테이너/사용자가 대량 파일삭제(Operation=='delete')를 반복하거나 대용량 BytesAccessed 삭제가 발생하는 패턴 탐지. 증거인멸 또는 임무데이터 파괴 의심. MITRE: T0809,T1485",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nlet bulkCountGate = 5;\nlet bulkBytesGate = 50000000;\nUAVFileAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where Operation == \"delete\"\n| summarize DeleteCount = count(), TotalBytes = sum(BytesAccessed), LastEvent = max(TimeGenerated), SampleFiles = make_set(FilePath, 10) by ContainerName, User\n| where DeleteCount >= bulkCountGate or TotalBytes >= bulkBytesGate\n| extend TriggerReason = strcat(\"데이터파괴_대량삭제_\", ContainerName, \"_\", tostring(DeleteCount), \"건\")\n| extend Severity = \"High\"\n| project TimeGenerated = LastEvent, ContainerName, User, DeleteCount, TotalBytes, SampleFiles, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1485"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S61 - Data Destruction (Logs / Mission / SAR Frames) - {{ContainerName}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | DeleteCount={{DeleteCount}} | TotalBytes={{TotalBytes}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "DeleteCount": "DeleteCount",
          "TotalBytes": "TotalBytes",
          "SampleFiles": "SampleFiles"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "ContainerName"
              }
            ]
          },
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "User"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
