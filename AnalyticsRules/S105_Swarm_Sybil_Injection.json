{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/bf4b9cf8-bcae-47c3-aeaa-30d321c6896c')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/bf4b9cf8-bcae-47c3-aeaa-30d321c6896c')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S105 - Sybil Member Injection into Swarm",
        "description": "UAVSwarmComms_CL의 member_roster 메시지에서 MemberCountObserved가 MemberCountExpected를 초과하거나, UnknownMemberIds 중 Approved_SystemId_List에 등록되지 않은 진짜 미확인 멤버(TrulyUnknownMembers)가 존재하는 Sybil 위장 멤버 주입 탐지. MITRE: T0859 Valid Accounts (ICS — description 참조)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet expectedMaxFleetSize = toscalar(_GetWatchlist('Approved_SystemId_List') | summarize count());\nUAVFleetState_CL\n| where TimeGenerated > ago(alertWindow)\n| where UnknownUavIdDetected == true and ActiveUAVCount > expectedMaxFleetSize\n| extend TriggerReason = strcat(\"Sybil위장멤버주입의심_활성UAV수_\", tostring(ActiveUAVCount), \"_등록기대상한_\", tostring(expectedMaxFleetSize))\n| extend Severity = \"High\"\n| project TimeGenerated, FleetId, WindowStart, ActiveUAVCount, UnknownUavIdDetected, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "InitialAccess"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S105 - Sybil Member Injection into Swarm - {{FleetId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "ActiveUAVCount": "ActiveUAVCount",
          "UnknownUavIdDetected": "UnknownUavIdDetected",
          "FleetId": "FleetId"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "FleetId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}