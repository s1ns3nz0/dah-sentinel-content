{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/7e2a4353-4cb4-417c-8867-21d4083c7042')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/7e2a4353-4cb4-417c-8867-21d4083c7042')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S98 - Passive Interception of Telemetry, Screen, Input, or File (Plaintext)",
        "description": "수동 텔레메트리·화면·입력·파일 감청(평문) 탐지. UAVPassiveCollect_CL의 CollectionType(telemetry|screen|input|file) 레코드 중 평문 링크로 노출된 경우(PlaintextLinkDetected=true)를 탐지. RF/유선 도청, 화면 캡처, 입력장치 후킹, 로컬 파일 무단 열람 등 암호화되지 않은 채널을 통한 수동 정보 수집. MITRE: T0887, T1125, T1119, T0845, T1113, T1005, T1056",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVPassiveCollect_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(CollectionType)\n| where PlaintextLinkDetected == true\n| extend TriggerReason = strcat('수동감청_평문노출_', CollectionType, '_', UAVId)\n| extend Severity = iff(CollectionType in ('telemetry', 'input'), 'High', 'Medium')\n| project TimeGenerated, UAVId, CollectionType, PlaintextLinkDetected, ProtocolObserved, CaptureMethod, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT20M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Collection"
        ],
        "techniques": [
          "T1125",
          "T1119",
          "T1113",
          "T1005",
          "T1056",
          "T1040"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S98 - Passive Plaintext Interception - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | CollectionType={{CollectionType}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "CollectionType": "CollectionType",
          "PlaintextLinkDetected": "PlaintextLinkDetected"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
