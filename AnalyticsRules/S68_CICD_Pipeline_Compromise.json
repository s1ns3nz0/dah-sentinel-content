{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/34e27ba6-88a9-443d-b27d-78bd3838b807')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/34e27ba6-88a9-443d-b27d-78bd3838b807')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S68 - CI/CD Pipeline Compromise",
        "description": "CI/CD 파이프라인 실행(PipelineRun) 중 승인되지 않은 빌드 스텝(InjectedStep) 삽입 또는 Approved_Operators_List에 없는 비인가 트리거(TriggeredBy)를 탐지. 빌드 도구/의존성 변조를 통한 공급망 침해 징후. MITRE: T1195.001",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet ApprovedOps = _GetWatchlist('Approved_Operators_List') | project OperatorId;\nUAVSupplyChain_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType == 'PipelineRun'\n| extend isInjected = isnotempty(InjectedStep)\n| extend isUnknownTrigger = TriggeredBy !in (ApprovedOps)\n| where isInjected or isUnknownTrigger\n| extend TriggerReason = case(\n    isInjected and isUnknownTrigger, strcat(\"CICD_비인가스텝주입_비인가트리거_\", PipelineId),\n    isInjected, strcat(\"CICD_비인가스텝주입_\", InjectedStep),\n    strcat(\"CICD_비인가_트리거_\", TriggeredBy))\n| extend Severity = \"High\"\n| project TimeGenerated, PipelineId, InjectedStep, TriggeredBy, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Initial Access"
        ],
        "techniques": [
          "T1195"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S68 - CI/CD Pipeline Compromise - {{PipelineId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | InjectedStep={{InjectedStep}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "PipelineId": "PipelineId",
          "InjectedStep": "InjectedStep"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "TriggeredBy"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
