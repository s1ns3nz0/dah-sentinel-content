{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/bf884638-92b0-4644-80ca-6c9e511074e6')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/bf884638-92b0-4644-80ca-6c9e511074e6')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S57 - Cron / World-Writable PATH Hijacking",
        "description": "UAVWebAudit_CL에서 새로운 cron 엔트리(CronEntry)가 기록되는 PATH 하이재킹형 지속성 확보 탐지. world-writable 경로(/tmp,/var/tmp,/dev/shm) 참조 여부를 부가 신호로 표시. MITRE: T1053.003,T1546",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVWebAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(CronEntry)\n| extend IsWorldWritablePath = CronEntry has_any (\"/tmp\", \"/var/tmp\", \"/dev/shm\")\n| extend TriggerReason = strcat(\"cron_PATH하이재킹_지속성확보_\", CronEntry)\n| extend Severity = \"High\"\n| project TimeGenerated, RequesterId, InstalledBy, CronEntry, TargetPath, IsWorldWritablePath, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Persistence",
          "PrivilegeEscalation"
        ],
        "techniques": [
          "T1053",
          "T1546"
        ],
        "subTechniques": [
          "T1053.003"
        ],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S57 - Cron / World-Writable PATH Hijacking - {{RequesterId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | CronEntry={{CronEntry}} | TargetPath={{TargetPath}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "CronEntry": "CronEntry",
          "TargetPath": "TargetPath",
          "InstalledBy": "InstalledBy"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "RequesterId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}