{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/ec344806-b872-46a6-8fe5-1a95a757c985')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/ec344806-b872-46a6-8fe5-1a95a757c985')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S81 - Fleet Management API Authorization Bypass (IDOR)",
        "description": "함대관리 API 호출 시 호출자 소속 함대(CallerFleetId)와 요청 대상 함대(RequestedFleetId)가 불일치하는 IDOR(비인가 객체 직접 참조) 시도를 탐지. MITRE: T1190",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nUAVFleetInfra_CL\n| where TimeGenerated > ago(alertWindow)\n| where IdorSuspected == true\n| where isnotempty(RequesterId) and isnotempty(TargetId)\n| where RequesterId != TargetId\n| extend TriggerReason = strcat(\"함대API_IDOR_\", FleetId, \"_requester:\", RequesterId, \"_target:\", TargetId)\n| extend Severity = \"High\"\n| project TimeGenerated, FleetId, RequesterId, TargetId, IdorSuspected, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "InitialAccess"
        ],
        "techniques": [
          "T1190"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S81 - Fleet API IDOR - {{FleetId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | RequesterId={{RequesterId}} | TargetId={{TargetId}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "RequesterId": "RequesterId",
          "TargetId": "TargetId"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "FleetId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}