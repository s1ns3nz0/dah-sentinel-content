{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/19444169-a70a-499a-9cb7-f2e69afbb235')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/19444169-a70a-499a-9cb7-f2e69afbb235')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S22 - Rogue mavlink-router Endpoint (C2 Proxy)",
        "description": "UAVRouterStats_CL(mavlink-router 통계)에서 UnexpectedEndpoint=true로 표시된 비인가/미등록 엔드포인트를 직접 탐지. CrcErrors 동반 시 신뢰도 High(회선 계층 이상 동시 시사).",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVRouterStats_CL\n| where TimeGenerated > ago(alertWindow)\n| where UnexpectedEndpoint == true\n| extend TriggerReason = strcat('mavlink-router_비인가_엔드포인트_탐지_', EndpointName, '_MsgTx:', tostring(MsgTx), '_MsgDropped:', tostring(MsgDropped), '_CrcErrors:', tostring(CrcErrors))\n| extend Severity = iff(CrcErrors > 0, 'High', 'Medium')\n| project TimeGenerated, EndpointName, MsgRx, MsgTx, MsgDropped, CrcErrors, UnexpectedEndpoint, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT15M",
        "queryPeriod": "P1D",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CommandAndControl"
        ],
        "techniques": [
          "T1090"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S22 - Rogue mavlink-router Endpoint (C2 Proxy) - {{EndpointName}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | MsgTx={{MsgTx}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "EndpointName": "EndpointName",
          "MsgTx": "MsgTx",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "EndpointName"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}