{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/57119be0-b20e-497e-b8f7-a0cf7558ab08')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/57119be0-b20e-497e-b8f7-a0cf7558ab08')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S54 - File Upload WebShell / Deserialization RCE",
        "description": "UAVWebAudit_CL에서 업로드 콘텐츠가 웹셸 시그니처(WebshellSignatureDetected)로 탐지된 이벤트를 탐지. 파일 업로드를 통한 웹셸 적재 또는 역직렬화 RCE 시도 의심. MITRE: T1505.003,T1059",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVWebAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where WebshellSignatureDetected == true\n| extend TriggerReason = strcat(\"웹셸_시그니처탐지_\", Filename, \"_패턴_\", MatchedPattern)\n| extend Severity = \"High\"\n| project TimeGenerated, RequesterId, Filename, ContentSnippet, MatchedPattern, WebshellSignatureDetected, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Persistence",
          "Execution"
        ],
        "techniques": [
          "T1505",
          "T1059"
        ],
        "subTechniques": [
          "T1505.003"
        ],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S54 - File Upload WebShell / Deserialization RCE - {{RequesterId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Filename={{Filename}} | MatchedPattern={{MatchedPattern}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Filename": "Filename",
          "MatchedPattern": "MatchedPattern",
          "StatusCode": "StatusCode"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "RequesterId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
