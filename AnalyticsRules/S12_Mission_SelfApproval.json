{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/bcc7ee61-6d04-46a8-b3e5-47739c14ead2')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/bcc7ee61-6d04-46a8-b3e5-47739c14ead2')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S12 - Mission Plan Self-Approval (2-person control bypass)",
        "description": "임무계획에서 Planner == Approver(자기승인) 또는 비인가 Planner 탐지. MITRE: T1078 Valid Accounts",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet ApprovedPlanners = _GetWatchlist('Approved_MPS_Planner_List') | project OperatorId;\nUAVMissionPlan_CL\n| where TimeGenerated > ago(alertWindow)\n| where Planner == Approver or Planner !in (ApprovedPlanners)\n| extend isSelfApproval = (Planner == Approver)\n| extend TriggerReason = case(\n    isSelfApproval, strcat(\"임무계획_자기승인_\", Planner),\n    strcat(\"임무계획_비인가_Planner_\", Planner))\n| extend Severity = \"High\"\n| project TimeGenerated, MissionId, Planner, Approver, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Credential Access"
        ],
        "techniques": [
          "T1078"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT1H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S12 - Mission Plan Self-Approval (2-person control bypass) - {{Planner}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "MissionId": "MissionId"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Planner"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}