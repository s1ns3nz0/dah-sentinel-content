{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/7e2a4353-4cb4-417c-8867-21d4083c7042')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/7e2a4353-4cb4-417c-8867-21d4083c7042')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S98 - Passive Interception of Telemetry, Screen, Input, or File (Plaintext) (Proxy - Design Blind Spot)",
        "description": "[설계상 사각지대 — 능동 신호 없음] 수동 텔레메트리·화면·입력·파일 감청(평문) 탐지. 평문/수동 감청은 정의상 방어자 시야에 로그를 남기지 않는 공격이므로(RF 도청, 케이블 탭, 화면/입력장치 후킹 등) 실배포 워크스페이스에 이를 직접 관측하는 텔레메트리가 존재하지 않는다. 이는 계측 누락이 아니라 의도된(intentional) 탐지 불가 영역일 가능성이 높다. 본 룰은 UAVDatalinkConn_CL의 연결 메타데이터(State/LocalIp/PeerIp/PeerPort)를 이용해 텔넷(23)·FTP(21)·TFTP(69)·HTTP(80)·RTSP(554)·PPTP(1723) 등 알려진 평문 프로토콜 포트로의 연결 패턴만 인접 신호로 근사 관측하며, 실제 평문 감청 발생 여부를 판정하지 않는다. 이 룰은 항상 결과가 []일 수 있으며, 이는 정상이다. MITRE: T1125, T1119, T1113, T1005, T1056, T1040",
        "severity": "Low",
        "enabled": true,
        "query": "let alertWindow = 15m;\nlet plaintextPorts = dynamic([21, 23, 69, 80, 554, 1723]);\nUAVDatalinkConn_CL\n| where TimeGenerated > ago(alertWindow)\n| where PeerPort in (plaintextPorts)\n| extend TriggerReason = strcat('평문가능성_연결패턴근사_', LocalIp, '_to_', PeerIp, ':', tostring(PeerPort))\n| extend Severity = 'Low'\n| project TimeGenerated, LocalIp, PeerIp, PeerPort, State, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT20M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Collection",
          "CredentialAccess"
        ],
        "techniques": [
          "T1125",
          "T1113",
          "T1005",
          "T1040"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S98 - Passive Plaintext Interception (Proxy) - {{LocalIp}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | PeerPort={{PeerPort}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "PeerIp": "PeerIp",
          "PeerPort": "PeerPort"
        },
        "entityMappings": [
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "LocalIp"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}