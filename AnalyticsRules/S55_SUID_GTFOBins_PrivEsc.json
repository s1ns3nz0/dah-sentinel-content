{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/6a6fdfeb-f2cc-4a82-b9a8-247bee1fca73')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/6a6fdfeb-f2cc-4a82-b9a8-247bee1fca73')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S55 - SUID/GTFOBins Privilege Escalation",
        "description": "UAVWebAudit_CL에서 GTFOBins 알려진 바이너리 실행이 GtfobinsMatch로 탐지되고 실행 전후 권한(PrivilegeBefore/PrivilegeAfter)이 상승하는 권한상승 탐지. MITRE: T1548.001,T1068",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVWebAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where GtfobinsMatch == true\n| where PrivilegeBefore != PrivilegeAfter\n| extend TriggerReason = strcat(\"GTFOBins_권한상승_\", Binary, \"_\", PrivilegeBefore, \"에서\", PrivilegeAfter, \"로\")\n| extend Severity = \"High\"\n| project TimeGenerated, RequesterId, Binary, Args, PrivilegeBefore, PrivilegeAfter, GtfobinsMatch, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Privilege Escalation",
          "Defense Evasion"
        ],
        "techniques": [
          "T1548",
          "T1068"
        ],
        "subTechniques": [
          "T1548.001"
        ],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S55 - SUID/GTFOBins Privilege Escalation - {{RequesterId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Binary={{Binary}} | Args={{Args}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Binary": "Binary",
          "Args": "Args",
          "PrivilegeAfter": "PrivilegeAfter"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "RequesterId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
