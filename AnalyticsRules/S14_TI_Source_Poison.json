{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/6647ba69-84bf-4b30-a50e-a8a1b2303cec')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/6647ba69-84bf-4b30-a50e-a8a1b2303cec')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S14 - Threat Intel Source Poisoning (Untrusted Source Injection)",
        "description": "Trusted_TI_Source_List 외부 소스에서 IOC 주입 또는 단시간 IOC 버스트 탐지. MITRE: T1195 Supply Chain Compromise",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet TrustedSources = _GetWatchlist('Trusted_TI_Source_List') | project SourceId;\nUAVThreatIntel_CL\n| where TimeGenerated > ago(alertWindow)\n| where Source !in (TrustedSources)\n| summarize Count=count(), FirstSeen=min(TimeGenerated) by Source\n| extend TriggerReason = strcat(\"TI_비신뢰_소스_\", Source)\n| extend Severity = \"High\"\n| project FirstSeen, Source, Count, TriggerReason, Severity\n| order by FirstSeen desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Collection"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S14 - Threat Intel Source Poisoning (Untrusted Source Injection) - {{Source}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Source"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}