{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/18ebad58-dea5-465c-bb0f-f88e66839604')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/18ebad58-dea5-465c-bb0f-f88e66839604')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S76 - MQTT/Message Bus Telemetry Poisoning",
        "description": "MQTT/메시지버스 텔레메트리 게시(MqttPublish)의 페이로드 이상탐지 점수(PayloadAnomalyScore)가 UAV_Threshold_List 동적 임계(MaxPayloadAnomalyScore)를 초과하는 토픽(TopicName)/게시자(PublisherId)를 탐지. MITRE: T1565.001",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nUAVDevOps_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType == \"mqtt_poison\"\n| where UnauthorizedPublish == true\n| extend TriggerReason = strcat(\"MQTT_텔레메트리_비인가게시_\", Topic, \"_\", Actor)\n| extend Severity = \"High\"\n| project TimeGenerated, Target, Actor, Topic, UnauthorizedPublish, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1565"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S76 - MQTT Telemetry Poisoning - {{Topic}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | UnauthorizedPublish={{UnauthorizedPublish}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Topic": "Topic",
          "Actor": "Actor"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Target"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}