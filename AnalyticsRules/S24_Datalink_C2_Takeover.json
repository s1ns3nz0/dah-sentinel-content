{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/f0b771dc-6be3-4dd7-babd-6f947a29a0d5')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/f0b771dc-6be3-4dd7-babd-6f947a29a0d5')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S24 - C2 Jamming/Datalink Channel Takeover",
        "description": "UAVDatalinkConn_CL에는 UAVId 컬럼이 없어 PeerIp/LocalPort 기준으로 엔티티를 재매핑. C2_Whitelisted_GCS_List에 없는 PeerIp(비인가 피어) 또는 State != 'ESTAB'(연결 비정상, 실 데이터 값 기준) 조건으로 데이터링크 C2 채널 나포를 탐지.",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet KnownGCS = _GetWatchlist('C2_Whitelisted_GCS_List') | project GCS_IP;\nUAVDatalinkConn_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(PeerIp)\n| extend isRoguePeer = PeerIp !in (KnownGCS)\n| where isRoguePeer or State != 'ESTAB'\n| extend TriggerReason = strcat('C2_통신채널_나포의심_State:', State, '_PeerIp:', PeerIp, '_LocalPort:', tostring(LocalPort))\n| extend Severity = iff(isRoguePeer, 'High', 'Medium')\n| project TimeGenerated, State, LocalIp, LocalPort, PeerIp, PeerPort, isRoguePeer, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CommandAndControl",
          "Impact",
          "InhibitResponseFunction"
        ],
        "techniques": [
          "T1499"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "IP"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S24 - C2 Jamming/Datalink Channel Takeover - {{PeerIp}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | State={{State}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "State": "State",
          "PeerPort": "PeerPort",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "PeerIp"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}