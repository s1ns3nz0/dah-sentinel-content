{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/361b54f5-8c76-4c88-ab04-c48b39c00719')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/361b54f5-8c76-4c88-ab04-c48b39c00719')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S123 - Fixed-Wing Stall Induction (Airspeed/Control Surface Manipulation)",
        "description": "UAVTelemetry_CL의 Airspeed_ms가 UAV_Threshold_List 워치리스트의 MinAirspeed_ms(실속 최소속도) 미만인 저속 구간을 탐지. UAVOpmode_CL은 존재하지 않아 실제 텔레메트리 Airspeed_ms 기반으로 재구성. MITRE: T0806 Brute Force I/O (제어면/속도 명령을 비인가로 조작해 고정익 실속을 유도)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet minAirspeed = toscalar(\n    _GetWatchlist('UAV_Threshold_List')\n    | where ThresholdKey == 'MinAirspeed_ms'\n    | project toreal(Value));\nUAVTelemetry_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotnull(Airspeed_ms)\n| where Airspeed_ms < minAirspeed\n| extend TriggerReason = strcat(\"고정익_실속유도_\", UAVId, \"_속도:\", tostring(Airspeed_ms), \"m/s<임계:\", tostring(minAirspeed))\n| project TimeGenerated, UAVId, Airspeed_ms, Groundspeed_ms, Pitch_rad, TriggerReason\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Collection",
          "Impact"
        ],
        "techniques": [
          "T1565"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S123 - Fixed-Wing Stall Induction (Airspeed/Control Surface Manipulation) - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Airspeed_ms": "Airspeed_ms"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}