{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/b534826e-0a55-43c4-a9d1-2519a0bf0c0d')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/b534826e-0a55-43c4-a9d1-2519a0bf0c0d')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S69 - Secrets/Key Vault Exfiltration",
        "description": "시크릿/키 관리(Vault) 시스템에서 임계치(UAV_Threshold_List.MaxVaultBulkReadPerHour) 초과 대량 조회(AnomalousBulkRead) 또는 Approved_Operators_List에 없는 비인가 접근자(AccessorIdentity)의 SecretPath 접근을 탐지. MITRE: T1552",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nlet bulkReadGate = toscalar(_GetWatchlist('UAV_Threshold_List') | where ThresholdKey == 'MaxVaultBulkReadPerHour' | project toint(Value));\nlet ApprovedOps = _GetWatchlist('Approved_Operators_List') | project OperatorId;\nUAVSupplyChain_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType == 'VaultAccess'\n| extend isBulk = (AnomalousBulkRead == true)\n| extend isUnknownAccessor = AccessorIdentity !in (ApprovedOps)\n| where isBulk or isUnknownAccessor\n| extend TriggerReason = case(\n    isBulk and isUnknownAccessor, strcat(\"Vault_대량조회_비인가접근자_\", AccessorIdentity),\n    isBulk, strcat(\"Vault_대량조회_임계\", bulkReadGate, \"_초과_\", SecretPath),\n    strcat(\"Vault_비인가_접근자_\", AccessorIdentity))\n| extend Severity = \"High\"\n| project TimeGenerated, SecretPath, AccessorIdentity, AnomalousBulkRead, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Credential Access"
        ],
        "techniques": [
          "T1552"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S69 - Secrets/Key Vault Exfiltration - {{AccessorIdentity}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | SecretPath={{SecretPath}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "SecretPath": "SecretPath",
          "AnomalousBulkRead": "AnomalousBulkRead"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "AccessorIdentity"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
