{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/7077c35d-0b86-42f2-bf35-bea290f3f52f')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/7077c35d-0b86-42f2-bf35-bea290f3f52f')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S29 - RC Link Binding Hijack (DSMX/FrSky/ELRS)",
        "description": "UAVRcLink_CL에서 BindEvent(bind_start/bind_complete) 발생 시 ObservedTxId(관측된 송신기 ID)가 ExpectedTxId(등록된 송신기 ID)와 불일치하면 RC 링크 바인딩 탈취 시도로 탐지. MITRE: T1555",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 10m;\nUAVRcLink_CL\n| where TimeGenerated > ago(alertWindow)\n| where BindCodeReused == true\n| extend TriggerReason = strcat('RC링크_바인딩코드_재사용_탈취의심_DeviceId:', DeviceId, '_Protocol:', ProtocolNegotiated)\n| extend Severity = 'Medium'\n| project TimeGenerated, UavId, DeviceId, ProtocolRequested, ProtocolNegotiated, BindCodeReused, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess"
        ],
        "techniques": [
          "T1555"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S29 - RC Link Binding Hijack (DSMX/FrSky/ELRS) - {{UavId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | ProtocolNegotiated={{ProtocolNegotiated}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "ProtocolNegotiated": "ProtocolNegotiated",
          "BindCodeReused": "BindCodeReused",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UavId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}