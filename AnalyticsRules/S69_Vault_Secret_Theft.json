{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/c2088d80-e9aa-4d02-a1c6-b50cdcb959fa')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/c2088d80-e9aa-4d02-a1c6-b50cdcb959fa')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S69 - Secrets/Key Vault Exfiltration",
        "description": "시크릿/키 관리(Vault) 시스템에서 임계치(UAV_Threshold_List.MaxVaultBulkReadPerHour) 초과 대량 조회(AnomalousBulkRead) 또는 Approved_Operators_List에 없는 비인가 접근자(AccessorIdentity)의 SecretPath 접근을 탐지. MITRE: T1552",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVDevOps_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType == \"vault_theft\"\n| where SecretExfilSuspected == true\n| extend TriggerReason = strcat(\"Vault_시크릿유출의심_\", Target, \"_\", Actor)\n| extend Severity = \"High\"\n| project TimeGenerated, Target, Actor, SecretExfilSuspected, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess"
        ],
        "techniques": [
          "T1552"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S69 - Secrets/Key Vault Exfiltration - {{Target}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | SecretExfilSuspected={{SecretExfilSuspected}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Target": "Target",
          "Actor": "Actor"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Actor"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}