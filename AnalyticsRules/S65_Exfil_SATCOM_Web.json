{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/3866e385-4563-4f84-b312-59c2bf4fa2e8')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/3866e385-4563-4f84-b312-59c2bf4fa2e8')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S65 - Exfiltration via SATCOM / Web Service (REST)",
        "description": "UAVSatcomLink_CL에서 SATCOM 대체매체 채널의 PayloadBytes 누적 전송량이 임계치(500MB)를 초과하는 대량 유출 탐지. 실시간 텔레메트리 대비 비정상적으로 큰 페이로드 전송을 위성링크 경유 데이터 유출 시도로 간주(웹 채널 전용 계측 테이블은 없어 SATCOM 신호에 집중). MITRE: T1011,T1567",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 15m;\nlet bytesGate = 500000000;\nUAVSatcomLink_CL\n| where TimeGenerated > ago(alertWindow)\n| summarize TotalBytes = sum(PayloadBytes), TransferCount = count(), LastEvent = max(TimeGenerated), AvgEntropy = avg(PayloadEntropy) by UAVId, LinkId, SrcAddr, DstAddr\n| where TotalBytes > bytesGate\n| extend TriggerReason = strcat(\"SATCOM_대용량유출_\", UAVId, \"_\", tostring(TotalBytes / 1000000), \"MB\")\n| extend Severity = \"Medium\"\n| project TimeGenerated = LastEvent, UAVId, LinkId, SrcAddr, DstAddr, TotalBytes, TransferCount, AvgEntropy, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Exfiltration"
        ],
        "techniques": [
          "T1011",
          "T1567"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S65 - Exfiltration via SATCOM / Web Service (REST) - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | DstAddr={{DstAddr}} | TotalBytes={{TotalBytes}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "LinkId": "LinkId",
          "DstAddr": "DstAddr",
          "TotalBytes": "TotalBytes"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "DstAddr"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
