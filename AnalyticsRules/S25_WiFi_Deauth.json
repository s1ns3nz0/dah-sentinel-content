{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/45b93993-eecb-4d6a-a8e9-584cc7cb88fd')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/45b93993-eecb-4d6a-a8e9-584cc7cb88fd')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S25 - WiFi Deauthentication Flood (Link Denial)",
        "description": "UAVRcLink_CL(WiFi/RC COTS 링크 계층 감사 테이블) 기반. 전용 802.11 프레임 캡처 테이블은 없어 EventType(deauth/disconnect류) 또는 StatusCode 비정상(연결 실패) 반복 발생을 디어쓰 유사 링크 거부 신호로 근사 탐지.",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet deauthCountGate = 3;\nUAVRcLink_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType has_any ('deauth', 'disconnect', 'wifi_deauth') or StatusCode != 0\n| summarize DeauthCount = count(), StatusCodes = make_set(StatusCode), LastSeen = max(TimeGenerated) by UavId, DeviceId, Ssid, TimeBin = bin(TimeGenerated, 5m)\n| where DeauthCount >= deauthCountGate\n| extend TriggerReason = strcat('WiFi_Deauth_링크거부_의심_', tostring(DeauthCount), '건_SSID:', Ssid)\n| extend Severity = 'Medium'\n| project TimeGenerated = LastSeen, UavId, DeviceId, Ssid, DeauthCount, StatusCodes, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1499"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S25 - WiFi Deauthentication Flood (Link Denial) - {{UavId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | DeauthCount={{DeauthCount}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "DeauthCount": "DeauthCount",
          "Ssid": "Ssid",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UavId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
