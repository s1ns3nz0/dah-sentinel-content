{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/2ec533d2-ffae-41d4-8465-0214a8e18ffb')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/2ec533d2-ffae-41d4-8465-0214a8e18ffb')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S106 - Flocking Rule Parameter Tampering (Separation/Alignment/Cohesion)",
        "description": "UAVSwarmComms_CL의 flock_rule_update 메시지에서 RuleParam(separation/alignment/cohesion)의 ValueBefore 대비 ValueAfter 변화율이 30% 초과하는 flocking 규칙 변조 탐지. MITRE: T0836 Modify Parameter (ICS — description 참조)",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet anomalyThreshold = 0.7;\nUAVFleetState_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotnull(AnomalyScore) and AnomalyScore > anomalyThreshold\n| extend TriggerReason = strcat(\"편대대형flocking규칙변조의심_AnomalyScore_\", tostring(AnomalyScore), \"_FleetId_\", FleetId)\n| extend Severity = \"Medium\"\n| project TimeGenerated, FleetId, WindowStart, AnomalyScore, ActiveUAVCount, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S106 - Flocking Rule Parameter Tampering - {{FleetId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "AnomalyScore": "AnomalyScore",
          "ActiveUAVCount": "ActiveUAVCount",
          "FleetId": "FleetId"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "FleetId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}