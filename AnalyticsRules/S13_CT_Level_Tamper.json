{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/fd71b607-1f6a-4627-8dee-aa2113da69fe')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/fd71b607-1f6a-4627-8dee-aa2113da69fe')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S13 - Cyber Posture CT Level Unauthorized Change",
        "description": "비인가 변경자의 CT 레벨 변경 탐지. 실제 컬럼: PreviousLevel, Level (LevelBefore/LevelAfter 없음), ChangedBy. MITRE: T1078 (Defense Evasion — description 참조)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet ApprovedChangers = _GetWatchlist('Approved_CT_Transition_List') | project OperatorId;\nUAVCyberPosture_CL\n| where TimeGenerated > ago(alertWindow)\n| where ChangedBy !in (ApprovedChangers)\n| extend TriggerReason = strcat(\"CT레벨_비인가_변경자:\", ChangedBy, \"_\", PreviousLevel, \"→\", Level)\n| extend Severity = \"High\"\n| project TimeGenerated, ChangedBy, PreviousLevel, Level, Reason, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S13 - Cyber Posture CT Level Unauthorized Change - {{ChangedBy}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "PreviousLevel": "PreviousLevel",
          "Level": "Level"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "ChangedBy"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}