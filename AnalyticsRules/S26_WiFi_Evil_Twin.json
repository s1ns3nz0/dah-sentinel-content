{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/14c9e1e9-4ae1-4607-ba89-ef52fce41982')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/14c9e1e9-4ae1-4607-ba89-ef52fce41982')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S26 - WiFi Evil Twin (Rogue AP C2 Hijack)",
        "description": "UAVRcLink_CL의 BssidMismatch(bool) 플래그를 직접 사용하여 동일 SSID에 대해 기대 BSSID와 불일치하는 접속(로그 AP/이블 트윈 의심)을 탐지.",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVRcLink_CL\n| where TimeGenerated > ago(alertWindow)\n| where BssidMismatch == true\n| summarize MismatchCount = count(), LastSeen = max(TimeGenerated) by UavId, DeviceId, Ssid\n| extend TriggerReason = strcat('WiFi_EvilTwin_BSSID불일치_탐지_', Ssid, '_', tostring(MismatchCount), '건')\n| extend Severity = 'Medium'\n| project TimeGenerated = LastSeen, UavId, DeviceId, Ssid, MismatchCount, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess",
          "Collection"
        ],
        "techniques": [
          "T1557"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S26 - WiFi Evil Twin (Rogue AP C2 Hijack) - {{UavId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Ssid={{Ssid}} | MismatchCount={{MismatchCount}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Ssid": "Ssid",
          "MismatchCount": "MismatchCount",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UavId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
