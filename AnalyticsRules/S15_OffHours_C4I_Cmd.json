{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/5553e0ec-dff8-4cba-9c29-a53cf56f52a4')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/5553e0ec-dff8-4cba-9c29-a53cf56f52a4')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S15 - Off-hours Unauthorized C4I Command",
        "description": "야간 시간대(23:00~05:00)에 Approved_Mission_Command_List 외부 CommandType으로 C4I 명령 발행 탐지. MITRE: T0821 Modify Controller Tasking",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet ApprovedCmds = _GetWatchlist('Approved_Mission_Command_List') | project CommandType;\nlet ApprovedSchedule = _GetWatchlist('Approved_Operation_Schedule_List') | project MissionId;\nUAVC4I_CL\n| where TimeGenerated > ago(alertWindow)\n| where hourofday(TimeGenerated) >= 23 or hourofday(TimeGenerated) < 5\n| where CommandType !in (ApprovedCmds)\n| extend TriggerReason = strcat(\"C4I_야간_비인가_명령_\", CommandType, \"_\", tostring(hourofday(TimeGenerated)), \"시\")\n| extend Severity = \"High\"\n| project TimeGenerated, UAVId, MissionId, CommandType, OperatorId, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Execution"
        ],
        "techniques": [
          "T0821"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT1H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S15 - Off-hours Unauthorized C4I Command - {{OperatorId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "CommandType": "CommandType",
          "MissionId": "MissionId"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "OperatorId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}