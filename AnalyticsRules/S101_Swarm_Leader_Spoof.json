{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/4ec19280-13e9-4d29-887b-d76cf8388a73')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/4ec19280-13e9-4d29-887b-d76cf8388a73')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S101 - Swarm Leader Spoofing / Hijacking",
        "description": "UAVSwarmComms_CL의 leader_beacon 메시지에서 ObservedLeaderId가 ExpectedLeaderId와 상이한 편대 리더 스푸핑·하이재킹 탐지. MITRE: T0856 Spoof Reporting Message (ICS 근사매핑 — description 참조)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nUAVFleetState_CL\n| where TimeGenerated > ago(alertWindow)\n| where UnknownUavIdDetected == true\n| extend TriggerReason = strcat(\"편대리더스푸핑의심_미확인UAV탐지_FleetId_\", FleetId, \"_CommonCommand_\", tostring(CommonCommand))\n| extend Severity = \"High\"\n| project TimeGenerated, FleetId, WindowStart, ActiveUAVCount, CommonCommand, UnknownUavIdDetected, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S101 - Swarm Leader Spoofing / Hijacking - {{FleetId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "CommonCommand": "CommonCommand",
          "UnknownUavIdDetected": "UnknownUavIdDetected",
          "FleetId": "FleetId"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "FleetId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}