{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/eb373655-6491-4d0e-827b-a2b499be7cb1')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/eb373655-6491-4d0e-827b-a2b499be7cb1')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S42 - GCS QML/Plugin Injection",
        "description": "GCS(QGroundControl류) 앱의 QML 컴포넌트/플러그인 인젝션 탐지. UAVCompanion_CL(ROS/컴패니언컴퓨터/설정/MQTT/NTP 등 EventType으로 구분되는 공용 테이블)에서 InjectionSignatureDetected=true인 이벤트를 탐지. 이 테이블은 여러 시나리오가 공유하므로 EventType 값 컨벤션으로 시나리오를 구분: 본 룰은 `EventType == \"qml_inject\"` 를 사용(다른 룰과 충돌 없음: ros_master_access=S45, ros_topic_inject=S46, mavros_cmd_inject=S47, gcs_update_mitm=S43, gcs_config_tamper=S44, ntp_spoof=S50, geofence_tamper=S77[타 담당]). 실제 컬럼: EventType, Target, ContentSnippet, InjectionSignatureDetected, StatusCode(UAVGcsApp_CL/SourceHost/BinarySigned/ComponentName/PayloadDetail/GcsHost 컬럼은 존재하지 않아 제거함). MITRE: T1059",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nUAVCompanion_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType == \"qml_inject\"\n| where InjectionSignatureDetected == true\n| extend TriggerReason = \"GCS_QML플러그인_인젝션_시그니처_탐지\"\n| extend Severity = \"High\"\n| project TimeGenerated, Target, EventType, ContentSnippet, InjectionSignatureDetected, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Execution"
        ],
        "techniques": [
          "T1059"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S42 - GCS QML/Plugin Injection - {{Target}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Target={{Target}} | ContentSnippet={{ContentSnippet}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Target": "Target",
          "ContentSnippet": "ContentSnippet"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Target"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
