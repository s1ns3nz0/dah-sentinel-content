{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/6a05218d-1949-41f5-b799-d833d263f58e')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/6a05218d-1949-41f5-b799-d833d263f58e')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S49 - Telemetry Relay MITM",
        "description": "텔레메트리 릴레이 중간자공격(MITM) 탐지 — UAVSatcomLink_CL(위성통신 링크 세션 테이블)에서 IntegrityStatus가 정상(ok)이 아니거나 왕복지연(RttMs)이 임계치를 초과해 급증한 경우를 탐지(MITM 프록시 삽입 시 전형적으로 나타나는 무결성 위반/지연 신호). 실제 컬럼: UAVId, LinkId, SessionId, IntegrityStatus, RttMs, JamIndicator, SrcAddr, DstAddr(UAVDatalinkInfra_CL/RemoteHost/DeviceId/NumericValue 컬럼은 존재하지 않아 제거함). MITRE: T1557",
        "severity": "High",
        "enabled": true,
        "query": "let maxRttMs = 500.0;\nlet alertWindow = 10m;\nUAVSatcomLink_CL\n| where TimeGenerated > ago(alertWindow)\n| where IntegrityStatus != \"ok\" or RttMs > maxRttMs\n| extend TriggerReason = case(\n    IntegrityStatus != \"ok\" and RttMs > maxRttMs, \"텔레메트리릴레이_무결성위반_RTT급증_동시\",\n    IntegrityStatus != \"ok\", \"텔레메트리릴레이_무결성_위반\",\n    \"텔레메트리릴레이_RTT_이상급증\")\n| extend Severity = \"High\"\n| project TimeGenerated, UAVId, LinkId, SessionId, SrcAddr, DstAddr, IntegrityStatus, RttMs, JamIndicator, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CredentialAccess",
          "Collection"
        ],
        "techniques": [
          "T1557"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S49 - Telemetry Relay MITM - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | RttMs={{RttMs}} | IntegrityStatus={{IntegrityStatus}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "RttMs": "RttMs",
          "IntegrityStatus": "IntegrityStatus"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}