{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/90ae4a17-b417-44f0-8aaa-a29e7c377811')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/90ae4a17-b417-44f0-8aaa-a29e7c377811')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S122 - ACRO/Manual Forced Destabilization",
        "description": "UAVTelemetry_CL에서 CustomMode=ACRO(1) 구간 중 RollSpeed_rads/PitchSpeed_rads/YawSpeed_rads 중 하나라도 임계값을 초과하는 불안정화 징후를 탐지. UAVOpmode_CL은 존재하지 않아 실제 텔레메트리 모드/각속도 컬럼 기반으로 재구성. MITRE: T0836 Modify Parameter (자동 안정화가 없는 ACRO/수동 모드를 비인가로 강제 주입해 기체를 불안정화)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nlet AcroMode = 1; // ArduPilot custom_mode convention: ACRO=1 (미확정 시 재검증 필요)\nlet RateThreshold = 2.0; // rad/s\nUAVTelemetry_CL\n| where TimeGenerated > ago(alertWindow)\n| where CustomMode == AcroMode\n| where isnotnull(RollSpeed_rads) and isnotnull(PitchSpeed_rads) and isnotnull(YawSpeed_rads)\n| where abs(RollSpeed_rads) > RateThreshold or abs(PitchSpeed_rads) > RateThreshold or abs(YawSpeed_rads) > RateThreshold\n| extend TriggerReason = strcat(\"ACRO강제전환_불안정화_\", UAVId)\n| project TimeGenerated, UAVId, CustomMode, RollSpeed_rads, PitchSpeed_rads, YawSpeed_rads, TriggerReason\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "DefenseEvasion"
        ],
        "techniques": [
          "T1562"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S122 - ACRO/Manual Forced Destabilization - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}