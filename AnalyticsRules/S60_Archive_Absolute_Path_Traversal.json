{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/41ed89a0-c610-4013-8646-e00300ed6eb2')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/41ed89a0-c610-4013-8646-e00300ed6eb2')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S60 - Archive Tar Absolute-Path Traversal",
        "description": "UAVArchiveAudit_CL에서 tar 아카이브 엔트리가 절대경로(/로 시작)로 기록되어 추출 루트를 무시하는 절대경로 순회가 AbsolutePathDetected 플래그로 탐지된 이벤트. MITRE: T1195",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVArchiveAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where AbsolutePathDetected == true\n| extend TriggerReason = strcat(\"tar_절대경로순회_\", ArchiveName, \"_\", EntryPath)\n| extend Severity = \"Medium\"\n| project TimeGenerated, ArchiveName, Mode, EntryPath, AbsolutePathDetected, ExtractedCount, BlockedCount, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "InitialAccess"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S60 - Archive Tar Absolute-Path Traversal - {{ArchiveName}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | EntryPath={{EntryPath}} | BlockedCount={{BlockedCount}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "ArchiveName": "ArchiveName",
          "EntryPath": "EntryPath",
          "BlockedCount": "BlockedCount"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "ArchiveName"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}