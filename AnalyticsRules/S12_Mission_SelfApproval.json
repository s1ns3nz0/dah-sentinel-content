{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/73bbd169-8d7a-404f-9671-253eb59daae0')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/73bbd169-8d7a-404f-9671-253eb59daae0')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S12 - Mission Plan Self-Approval (2-person control bypass)",
        "description": "임무계획에서 Planner == Approver(자기승인) 탐지. 실제 컬럼: PlanId(MissionId 없음), Planner, Approver. MITRE: T1078 Valid Accounts (Credential Access — description 참조)",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet ApprovedPlanners = _GetWatchlist('Approved_Arm_Operator_List') | project OperatorId;\nUAVMissionPlan_CL\n| where TimeGenerated > ago(alertWindow)\n| where Planner == Approver\n| extend TriggerReason = strcat(\"임무계획_자기승인_Planner:\", Planner, \"_PlanId:\", PlanId)\n| extend Severity = \"High\"\n| project TimeGenerated, PlanId, Planner, Approver, UAVId, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S12 - Mission Plan Self-Approval (2-person control bypass) - {{Planner}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "PlanId": "PlanId"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "Planner"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}