{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/53201dd6-efd0-46fc-8cb5-5d0deebd3680')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/53201dd6-efd0-46fc-8cb5-5d0deebd3680')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S46 - ROS Topic/Service Injection",
        "description": "ROS 토픽/서비스 인젝션 탐지 — UAVCompanion_CL(ROS/컴패니언컴퓨터/설정/MQTT/NTP 등 EventType으로 구분되는 공용 테이블)에서 InjectionSignatureDetected=true인 토픽 인젝션 이벤트를 탐지(Topic/Command 컬럼으로 세부 내용 확인). 이 테이블은 여러 시나리오가 공유하므로 EventType 값 컨벤션으로 시나리오를 구분: 본 룰은 `EventType == \"ros_topic_inject\"` 를 사용(다른 룰과 충돌 없음: qml_inject=S42, gcs_update_mitm=S43, gcs_config_tamper=S44, ros_master_access=S45, mavros_cmd_inject=S47, ntp_spoof=S50, geofence_tamper=S77[타 담당]). 실제 컬럼: EventType, Target, Topic, Command, InjectionSignatureDetected, StatusCode(UAVRos_CL/NodeName/PeerIp/TopicName/CommandSummary 컬럼은 존재하지 않아 제거함). MITRE ICS ATT&CK: T0855 Unauthorized Command Message",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nUAVCompanion_CL\n| where TimeGenerated > ago(alertWindow)\n| where EventType == \"ros_topic_inject\"\n| where InjectionSignatureDetected == true\n| extend TriggerReason = strcat(\"ROS_민감토픽_인젝션_시그니처_탐지_\", Topic)\n| extend Severity = \"High\"\n| project TimeGenerated, Target, Topic, Command, InjectionSignatureDetected, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1565"
        ],
        "subTechniques": [
          "T1565.002"
        ],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S46 - ROS Topic/Service Injection - {{Target}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Topic={{Topic}} | Command={{Command}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "Topic": "Topic",
          "Command": "Command"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Target"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}