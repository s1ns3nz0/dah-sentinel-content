{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/ba447d3f-5b4a-4d4a-ad6e-71069d73420a')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/ba447d3f-5b4a-4d4a-ad6e-71069d73420a')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S100 - Swarm-Induced Alert Saturation (SOC Response Neutralization)",
        "description": "군집포화(SOC 대응 무력화) 탐지. UAVSocLoad_CL에서 동시발생 경보 수(SimultaneousAlertCount)가 구성된 처리용량 임계값(CapacityThreshold)을 초과하고 SOC 대응지연(ResponseDelaySec)이 급증한 구간을 탐지. 다수 UAV 군집을 동시에 이상행동시켜 SOC 경보 처리 용량을 포화시키고 실제 공격을 은폐/무력화하려는 시도. MITRE: T1499",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet responseDelayGate = 120;\nUAVSocLoad_CL\n| where TimeGenerated > ago(alertWindow)\n| where SimultaneousAlertCount > CapacityThreshold\n| where ResponseDelaySec >= responseDelayGate\n| extend OverloadRatio = round(todouble(SimultaneousAlertCount) / todouble(CapacityThreshold), 2)\n| extend UAVId = 'SOC-CAPACITY'\n| extend TriggerReason = strcat('SOC_군집포화_대응지연_', tostring(SwarmSizeInvolved), '기_지연', tostring(ResponseDelaySec), 's')\n| extend Severity = 'High'\n| project TimeGenerated, UAVId, SwarmSizeInvolved, SimultaneousAlertCount, CapacityThreshold, OverloadRatio, ResponseDelaySec, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1499"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S100 - Swarm Alert Saturation - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | OverloadRatio={{OverloadRatio}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "SwarmSizeInvolved": "SwarmSizeInvolved",
          "OverloadRatio": "OverloadRatio"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
