{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/f614dcd0-abbe-4a10-8a90-f13616cdced0')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/f614dcd0-abbe-4a10-8a90-f13616cdced0')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S62 - Rootkit (LD_PRELOAD / Kernel Module Insertion)",
        "description": "UAVFileAudit_CL에서 지속성 확보 대상(LD_PRELOAD 파일/커널모듈 경로 등)이 PersistenceTargetSuspected 플래그로 탐지된 파일 조작 이벤트를 은폐형 루트킷 설치 시도로 탐지. MITRE: T1014,T0851",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVFileAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where PersistenceTargetSuspected == true\n| extend TriggerReason = strcat(\"rootkit_지속성타겟의심_\", ProcessName, \"_\", FilePath)\n| extend Severity = \"High\"\n| project TimeGenerated, ContainerName, Pid, ProcessName, Operation, FilePath, Syscall, User, PersistenceTargetSuspected, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "DefenseEvasion"
        ],
        "techniques": [
          "T1014"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S62 - Rootkit (LD_PRELOAD / Kernel Module Insertion) - {{ContainerName}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | ProcessName={{ProcessName}} | FilePath={{FilePath}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "ProcessName": "ProcessName",
          "FilePath": "FilePath",
          "Syscall": "Syscall"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "ContainerName"
              }
            ]
          },
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "User"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}