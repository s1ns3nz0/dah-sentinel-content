{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/14722870-7f77-46aa-94c7-9e71102a245f')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/14722870-7f77-46aa-94c7-9e71102a245f')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S53 - Weapon Endpoint IDOR (Auth Bypass)",
        "description": "UAVWebAudit_CL에서 무기(weapon/arm/fire) 엔드포인트 요청자(RequesterId)가 자신의 소유가 아닌 타 UAV/자원(TargetId)에 접근하는 IDOR(직접객체참조) 의심 이벤트를 IdorSuspected 플래그로 탐지. 인증우회형 취약점 악용 의심. MITRE: T1078",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVWebAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where IdorSuspected == true\n| where RequesterId != TargetId\n| extend TriggerReason = strcat(\"IDOR_비인가접근_\", RequesterId, \"_대상_\", TargetId)\n| extend Severity = \"High\"\n| project TimeGenerated, RequesterId, TargetId, StatusCode, IdorSuspected, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Initial Access"
        ],
        "techniques": [
          "T1078"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Account"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S53 - Weapon Endpoint IDOR (Auth Bypass) - {{RequesterId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | TargetId={{TargetId}} | StatusCode={{StatusCode}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "TargetId": "TargetId",
          "StatusCode": "StatusCode"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "RequesterId"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "TargetId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
