{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/84587cb4-4003-4df5-8813-869126259cb1')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/84587cb4-4003-4df5-8813-869126259cb1')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S56 - Container Escape (Privileged / docker.sock hostPath)",
        "description": "UAVWebAudit_CL에서 컨테이너 탈출 기법(EscapeMethod, 예: privileged/docker.sock/cgroup release_agent 등)이 기록된 이벤트를 탐지. 컨테이너 탈출을 통한 호스트 장악 위험. MITRE: T1611",
        "severity": "High",
        "enabled": true,
        "query": "let alertWindow = 15m;\nUAVWebAudit_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(EscapeMethod)\n| extend TriggerReason = strcat(\"컨테이너탈출_\", EscapeMethod, \"_호스트장악위험\")\n| extend Severity = \"High\"\n| project TimeGenerated, RequesterId, EscapeMethod, TargetPath, StatusCode, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "PrivilegeEscalation"
        ],
        "techniques": [
          "T1611"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S56 - Container Escape (Privileged / docker.sock hostPath) - {{RequesterId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | EscapeMethod={{EscapeMethod}} | TargetPath={{TargetPath}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "EscapeMethod": "EscapeMethod",
          "TargetPath": "TargetPath",
          "StatusCode": "StatusCode"
        },
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "RequesterId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}