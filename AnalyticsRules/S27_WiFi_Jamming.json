{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/08425db0-d2f1-409d-abc7-6914abeb245e')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/08425db0-d2f1-409d-abc7-6914abeb245e')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S27 - WiFi RF Jamming (Loss of Control)",
        "description": "UAVWifi_CL은 실 워크스페이스에 존재하지 않음. WiFi 대역 RF 재밍은 UAVCounterUas_CL(Band='wifi', JsRatio_dB/JamEirp_dBm)이 더 정확한 실제 컬럼을 제공하므로 이를 사용해 근사 탐지.",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet jsRatioGate = 6.0;\nUAVCounterUas_CL\n| where TimeGenerated > ago(alertWindow)\n| where Band has 'wifi'\n| where JsRatio_dB > jsRatioGate\n| summarize AvgJsRatio = avg(JsRatio_dB), AvgEirp = avg(JamEirp_dBm), LastSeen = max(TimeGenerated) by UAVId, JamMode\n| extend TriggerReason = strcat('WiFi_재밍_통제상실의심_JsRatio:', tostring(round(AvgJsRatio,1)), 'dB_Mode:', JamMode)\n| extend Severity = 'Medium'\n| project TimeGenerated = LastSeen, UAVId, JamMode, AvgJsRatio, AvgEirp, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "Impact"
        ],
        "techniques": [
          "T1498"
        ],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT2H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [
              "Host"
            ],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S27 - WiFi RF Jamming (Loss of Control) - {{UAVId}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | AvgJsRatio={{AvgJsRatio}} | AvgEirp={{AvgEirp}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "AvgJsRatio": "AvgJsRatio",
          "AvgEirp": "AvgEirp",
          "Severity": "Severity"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "UAVId"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}
