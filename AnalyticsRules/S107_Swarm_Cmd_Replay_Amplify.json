{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "String"
    }
  },
  "resources": [
    {
      "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/c1f362a0-60d2-4900-a591-39c5abc23181')]",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/c1f362a0-60d2-4900-a591-39c5abc23181')]",
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "kind": "Scheduled",
      "apiVersion": "2023-12-01-preview",
      "properties": {
        "displayName": "UAV S107 - Swarm Command Replay/Amplification (1:N)",
        "description": "UAVSwarmComms_CL의 command_replay 메시지에서 동일 CommandId가 원본 발생 60초 이내 3회 초과 재생(ReplayCount)되는 스웜 명령 리플레이/증폭(1:N) 탐지. MITRE: T0857 System Firmware (ICS 근사매핑 — description 참조, 실제 공격패턴은 명령 메시지 재생/증폭)",
        "severity": "Medium",
        "enabled": true,
        "query": "let alertWindow = 10m;\nlet replayCountThreshold = 3;\nUAVFleetState_CL\n| where TimeGenerated > ago(alertWindow)\n| where isnotempty(CommonCommand)\n| summarize ReplayCount = count(), FleetIds = make_set(FleetId) by CommonCommand, TimeBin = bin(TimeGenerated, 1m)\n| where ReplayCount > replayCountThreshold\n| extend TriggerReason = strcat(\"스웜명령리플레이증폭의심_명령_\", CommonCommand, \"_반복횟수_\", tostring(ReplayCount))\n| extend Severity = \"Medium\"\n| project TimeGenerated = TimeBin, CommonCommand, ReplayCount, FleetIds, TriggerReason, Severity\n| order by TimeGenerated desc",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT2H",
        "suppressionEnabled": false,
        "startTimeUtc": null,
        "tactics": [
          "CommandAndControl"
        ],
        "techniques": [],
        "subTechniques": [],
        "alertRuleTemplateName": null,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "SingleAlert"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "UAV S107 - Swarm Command Replay/Amplification - {{CommonCommand}}",
          "alertDescriptionFormat": "TriggerReason={{TriggerReason}} | Severity={{Severity}}",
          "alertDynamicProperties": []
        },
        "customDetails": {
          "TriggerReason": "TriggerReason",
          "CommonCommand": "CommonCommand",
          "ReplayCount": "ReplayCount",
          "FleetIds": "FleetIds"
        },
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "CommonCommand"
              }
            ]
          }
        ],
        "sentinelEntitiesMappings": null,
        "templateVersion": null
      }
    }
  ]
}